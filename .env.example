NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Remetente dos emails (domínio verificado no Resend). Ex.: "Oracle <faturas@seudominio.fr>".
# Sem isto, usa o remetente sandbox (apenas desenvolvimento).
EMAIL_FROM=
CRON_SECRET=

# Meu Conselheiro — allowlist de emails que acessam o painel /admin/conselheiro
# (separados por vírgula). Sem isto, ninguém é admin (fail-closed).
ADVISOR_ADMIN_EMAILS=
# Caixa que recebe a notificação por email de cada nova mensagem do Conselheiro.
# Default no código: gestion@profrance-services.fr.
ADVISOR_NOTIFY_EMAIL=

# Stripe (billing). Chaves em https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_...), obtido ao criar o webhook no Stripe.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# URL pública do app (sem barra final). Ex.: https://app.profrance.services
NEXT_PUBLIC_APP_URL=
# Price IDs (price_...) de cada plano de assinatura. Nunca hardcode no código.
STRIPE_PRICE_ESSENTIEL=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
